<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Tab image (composited with playhead + dim directly onto bitmap) -->
    <ImageView
        android:id="@+id/pdfImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:background="@color/black"
        android:contentDescription="Tab segment" />

    <!-- BPM label — top-left, only shown in IDLE state -->
    <TextView
        android:id="@+id/bpmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textColor="@color/page_indicator"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="@color/black"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:text="♩ 70" />

    <!-- Page indicator — top-right -->
    <TextView
        android:id="@+id/pageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="8dp"
        android:textColor="@color/page_indicator"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:background="@color/black"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:text="1 / 8" />

    <!--
        Count-in overlay — large beat number, centre screen.
        Visible only during COUNT_IN state.
    -->
    <TextView
        android:id="@+id/countInLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:textColor="#CCFFFFFF"
        android:textSize="72sp"
        android:fontFamily="sans-serif-light"
        android:text="1"
        android:visibility="invisible" />

    <!-- Gesture / status hint — bottom centre -->
    <TextView
        android:id="@+id/gestureHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:textColor="@color/page_indicator"
        android:textSize="13sp"
        android:background="@color/black"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text=""
        android:visibility="invisible" />

</FrameLayout>
